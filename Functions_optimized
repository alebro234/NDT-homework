#RESOLUTION OF T MAP W/ ITERATIVE PROCEDURE IN FUEL 

def T_axial(q1_vec, mdot, T_in, p, R_co, R_ci, R_fo, R_fi, z_nodes, Por, Pu, Bu, f):

    A_ch = (np.sqrt(3) / 4) * (p**2) - (np.pi * (R_co**2)) / 2
    D_h = (4 * A_ch) / (np.pi * R_co)
    arrays = [np.zeros(np.size(q1_vec)) for _ in range(3)]
    u_cool, h_cool, T_co = arrays
    # q1_vec = q1_vec*f
    n = 100
    T_cool = np.zeros(np.size(q1_vec))
    T_cool[0] = T_in
    T_cl = np.zeros((np.size(q1_vec), n))
    T_gap = np.zeros((np.size(q1_vec), n))
    T_fu = np.zeros((np.size(q1_vec), n))

    for i in list(range(len(z_nodes)-1)):
        
        T_cool[i + 1] = T_cool[i] + np.trapz(q1_vec[i:i+2]*f, z_nodes[i:i+2]) / (mdot * co.cp_cool(T_cool[i]))
    for i in list(range(len(z_nodes))):    
        u_cool[i] = mdot / (co.rho_cool(T_cool[i]) * A_ch[i])
        h_cool[i] = (co.Nu_cool(co.Pe_cool(T_cool[i], u_cool[i], D_h[i])) * co.k_cool(T_cool[i])) / D_h[i]
        T_co[i] = T_cool[i] + q1_vec[i]*f / (2 * np.pi * R_co[i] * h_cool[i])
        
        R_cl = np.linspace(R_co[i], R_ci[i], n) # Discretize the radius of the cladding
        T_cl[i, 0] = T_co[i] # Set the initial temperature in the cladding to the last temperature in the coolant
        
        for j in range(np.size(R_cl) - 1): # j is the index spanning over the dr for the cladding
            T_cl[i, j + 1] = T_cl[i, j] + (q1_vec[i] * np.log(R_cl[j] / R_cl[j + 1])) / (2 * np.pi * co.k_cl(T_cl[i, j])) 
            
        R_gap = np.linspace(R_ci[i], R_fo[i], n) # Discretize the radius of the gap
        T_gap[i, 0] = T_cl[i, -1] # Set the initial temperature in the gap to the last temperature in the cladding
        
        # for k in range(np.size(R_gap) - 1): # k is the index spanning over the dr for the gap
            # Calculate the temperature at the next radial position in the gap
            # T_gap[i, k + 1] = T_gap[i, k] + (q1_vec[i] * (R_gap[k] - R_gap[k + 1]))/ (2 * np.pi * R_gap[k] * co.k_gap(T_gap[i, k]))

        fun = lambda T: T - T_cl[i,-1] - (q1_vec[i] * (R_gap[0] - R_gap[-1])) / (2*np.pi*R_fo[i]*co.k_gap( (T_gap[i, 0] + T)/2 ))

        T_gap[i, -1] = fsolve(fun,T_gap[i, 0] )


            
        R_fu = np.linspace(R_fo[i], R_fi[i], n) # Discretize the radius of the fuel
        T_fu[i, 0] = T_gap[i, -1] # Set the initial temperature in the fuel to the last temperature in the gap
        Tfu_max_0 = T_fu[i, 0] + q1_vec[i]/(4*np.pi*co.k_fuel(Bu, Por, Pu, T_fu[i, 0]))
        err = 100
        toll = 1e-10
        count = 0
        while err > toll:
            Tfu_max_new = T_fu[i, 0] + q1_vec[i]/(4*np.pi*co.k_fuel(Bu, Por, Pu, (T_fu[i, 0] + Tfu_max_0)/2))
            err = abs(Tfu_max_0 - Tfu_max_new)
            Tfu_max_0 = Tfu_max_new
            count = count + 1
        
        k_fuel_iterative = co.k_fuel(Bu, Por, Pu, (T_fu[i, 0] + Tfu_max_0)/2)
        for l in range(np.size(R_fu) - 1): # l is the index spanning over the dr for the fuel
            # Calculate the temperature at the next radial position in the fuel
            T_fu_fun = lambda r: T_fu[i, 0] + q1_vec[i]/(4*np.pi*k_fuel_iterative)*(1-r**2/R_fo[i]**2)
            T_fu[i, l + 1] = T_fu_fun(R_fu[l + 1]) 

    return [ T_cool, T_cl, R_cl, T_gap, R_gap, T_fu, R_fu, u_cool, h_cool, k_fuel_iterative, Tfu_max_0, count]



